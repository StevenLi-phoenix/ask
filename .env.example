# Copy to .env (read from the directory you run `ask` in) and fill in what you use.
# Plain KEY=value lines, no quotes. Real environment variables win over this file.

# One key per provider; only the selected provider's key is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Model used when -m is not given: openai | claude | deepseek | haiku | flash | any model id.
# Default is Claude Haiku.
# ASK_GLOBAL_MODEL=claude

# Gateway mode (e.g. OpenRouter): one endpoint and one key for whatever model you pick.
# The shortcuts above expand to each vendor's own ids, so use the gateway's model slugs here.
# ASK_BASE_URL=https://openrouter.ai/api/v1
# ASK_MODEL_KEY=sk-or-v1-...
# ASK_GLOBAL_MODEL=anthropic/claude-haiku-5.5
